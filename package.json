{
  "name": "yahtzee-score-card",
  "version": "1.0.0",
  "private": true,
  "description": "Apple-styled Yahtzee score card PWA that auto-rotates between players.",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "node tests/scoring.test.js",
    "build:web": "bash scripts/build-web.sh",
    "ios:sync": "npm run build:web && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "build:dice": "esbuild src/dice3d.js --bundle --minify --format=iife --global-name=Dice3D --outfile=vendor/dice3d.js --legal-comments=eof"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "esbuild": "^0.25.12",
    "three": "^0.186.1"
  }
}
